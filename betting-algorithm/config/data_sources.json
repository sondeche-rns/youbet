    {
      "id": "fbref",
      "name": "FBref (Future)",
      "enabled": false,
      "type": "scraper",
      "description": "Advanced football statistics (requires web scraping)",
      "base_url": "https://fbref.com",
      "sports": ["football"],
      "features": [
        "xG (Expected Goals)",
        "Shot quality metrics",
        "Possession statistics",
        "Passing networks"
      ],
      "note": "Requires careful rate limiting and compliance with ToS"
    },
    {
      "id": "api-football",
      "name": "API-Football",
      "enabled": false,
      "type": "api",
      "description": "Comprehensive football API (requires paid subscription)",
      "base_url": "https://v3.football.api-sports.io",
      "requires_api_key": true,
      "api_key_env": "API_FOOTBALL_KEY",
      "rate_limit": {
        "free_tier": "100 requests/day",
        "paid_tier": "Varies by plan"
      },
      "sports": ["football"],
      "endpoints": {
        "fixtures": "/fixtures",
        "odds": "/odds",
        "statistics": "/fixtures/statistics",
        "lineups": "/fixtures/lineups"
      }
    },
    {
      "id": "the-odds-api",
      "name": "The Odds API",
      "enabled": true,
      "type": "api",
      "description": "Live and historical betting odds",
      "base_url": "https://api.the-odds-api.com",
      "requires_api_key": true,
      "api_key_env": "ODDS_API_KEY",
      "rate_limit": {
        "free_tier": "500 requests/month",
        "paid_tier": "Custom plans available"
      },
      "sports": ["football", "basketball", "tennis", "baseball"],
      "endpoints": {
        "sports": "/v4/sports",
        "odds": "/v4/sports/{sport}/odds",
        "scores": "/v4/sports/{sport}/scores"
      }
    },
    {
      "id": "custom-csv",
      "name": "Custom CSV Import",
      "enabled": true,
      "type": "file",
      "description": "Import your own CSV data files",
      "directory": "./data/custom",
      "required_columns": [
        "Date",
        "home_team",
        "away_team",
        "home_goals",
        "away_goals"
      ],
      "optional_columns": [
        "home_odds",
        "draw_odds",
        "away_odds",
        "competition",
        "season"
      ]
    }
  ],
  "default_config": {
    "default_sport": "football",
    "default_leagues": ["E0"],
    "default_seasons": ["2324", "2223", "2122"],
    "enable_caching": true,
    "cache_directory": "./data/cache",
    "retry_attempts": 3,
    "retry_delay_seconds": 2
  }
